# ===== Vexoo Framer Form -> Make.com middleware =====
# Copy this to .env and fill in your real values (local dev only).
# On Vercel, set these as Environment Variables in the dashboard instead.

# Your Framer webhook signing secret (from Framer form settings / setup email)
FRAMER_WEBHOOK_SECRET=your_framer_webhook_secret_here

# Your Make.com webhook URL (https://hook.make.com/...)
MAKE_WEBHOOK_URL=https://hook.make.com/your_make_webhook_here

# (optional) local server port
PORT=8787